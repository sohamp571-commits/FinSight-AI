# ==========================================================
# FinSight AI - Environment Variable Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to version control.
# ==========================================================

# --------------- Application ---------------
APP_NAME=FinSight AI
APP_ENV=development
APP_DEBUG=True
SECRET_KEY=change-this-to-a-random-64-character-string

# --------------- MySQL Database ---------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finsight_ai
DB_USER=root
DB_PASSWORD=soham@123
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# --------------- External APIs (used in later phases) ---------------
NEWS_API_KEY=your_newsapi_key_here

# --------------- Logging ---------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --------------- Security ---------------
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
